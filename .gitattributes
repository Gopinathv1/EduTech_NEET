# Release fingerprints use exact bytes across Windows and Linux checkouts.
data/previous-year/neet/release-2013-2025/*.json text eol=lf
data/previous-year/neet/2014/source-gate.json text eol=lf
data/previous-year/jee/**/*.json text eol=lf
data/previous-year/jee/*.json text eol=lf
# The acquired key inventory was sealed with its original CRLF bytes.
data/previous-year/jee/final-answer-keys.json -text whitespace=cr-at-eol
# The user-authorized release digest also identifies its original CRLF bytes.
data/previous-year/jee/release-manifest.json -text whitespace=cr-at-eol
