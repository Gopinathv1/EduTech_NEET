{
  "name": "neet-smart-practice-platform",
  "version": "0.1.0",
  "private": true,
  "description": "NEET Smart Practice & Admission Assistance Platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:seed:reference": "tsx prisma/seed-reference.ts",
    "admin:create": "tsx prisma/create-admin.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "load": "k6 run load/load-test.js",
    "ci": "npm run lint && npm run typecheck && npm run test",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
    "@prisma/client": "^6.2.1",
    "@sentry/nextjs": "^8.55.2",
    "jose": "^6.2.7",
    "next": "^15.5.22",
    "next-intl": "^3.26.3",
    "papaparse": "^5.5.4",
    "pdfkit": "^0.19.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.84.0",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "@types/papaparse": "^5.5.2",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^3.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.22",
    "postcss": "^8.5.1",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
