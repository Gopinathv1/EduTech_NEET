# ---------------------------------------------------------------------------
# NEET Smart Practice & Admission Assistance Platform — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Full deployment guidance: see DEPLOYMENT.md.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# PostgreSQL connection string used by Prisma at runtime.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# In production behind a pooler (PgBouncer/Neon/Supabase), point this at the
# POOLED connection and add `?pgbouncer=true&connection_limit=<n>`.
DATABASE_URL="postgresql://neondb_owner:npg_4dfDwc7JxUhz@ep-mute-dawn-azv2zau2-pooler.c-3.ap-southeast-1.aws.neon.tech/NEET?sslmode=require&channel_binding=require"

# Direct (non-pooled) connection used ONLY by `prisma migrate deploy` (DDL can't
# run over a transaction pooler). Optional locally; required with a pooled DB.
DIRECT_URL="postgresql://neondb_owner:npg_4dfDwc7JxUhz@ep-mute-dawn-azv2zau2.c-3.ap-southeast-1.aws.neon.tech/NEET?sslmode=require&channel_binding=require"

# --- Auth ------------------------------------------------------------------
# Secret used to sign authentication JWTs. Use a long random string in prod
# (e.g. `openssl rand -base64 48`). The app throws at runtime if this is unset.
JWT_SECRET="change_me_to_a_long_random_secret"

# --- Razorpay --------------------------------------------------------------
# Test keys (rzp_test_*) or live keys (rzp_live_*). With placeholder values the
# app runs in mock-order mode so the flow works locally without a gateway.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# Webhook signing secret (from the Razorpay dashboard webhook you create).
# Empty → all webhooks are rejected with 400.
RAZORPAY_WEBHOOK_SECRET="whsec_test_change_me"

# --- OTP provider ----------------------------------------------------------
# SMS/OTP gateway API key. REQUIRED in production (the app throws without it),
# unless OTP_DEV_MODE=true below. In development a console provider echoes the
# OTP so no key is needed.
OTP_PROVIDER_API_KEY="your_otp_provider_api_key"

# Force dev/test OTP mode even in a deployed (production) environment: no real
# SMS is sent — the OTP is logged to the server console AND returned on-screen so
# you can test register/login without an SMS gateway.
# ⚠️ TESTING ONLY — it exposes the OTP to the client. Never enable for real users.
# OTP_DEV_MODE="true"

# --- Site ------------------------------------------------------------------
# Public base URL (SEO canonical + Open Graph). Defaults to http://localhost:3000
# in dev; MUST be the real https URL in production.
NEXT_PUBLIC_SITE_URL="https://console.neon.tech/app/projects/super-tree-61204382?database=NEET"

# --- Business config -------------------------------------------------------
# FULL_TEST score at/below which the "explore abroad" banner appears (default 450).
ADMISSION_SCORE_CUTOFF=450

# --- File storage (question images) ----------------------------------------
# Unset/anything = local disk (public/uploads, DEV ONLY — not durable on
# serverless). Set to "s3" to use S3-compatible cloud storage (AWS S3, Cloudflare
# R2, Supabase Storage, MinIO).
# STORAGE_DRIVER="s3"
# S3_BUCKET="neet-uploads"
# S3_REGION="ap-south-1"
# S3_ACCESS_KEY_ID=""            # omit to use the host's IAM role
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""                 # for R2/MinIO/Supabase, e.g. https://<acct>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE="true"     # for R2/MinIO/Supabase
# S3_PUBLIC_URL=""               # CDN/public base, e.g. https://cdn.example.in
# S3_OBJECT_ACL="public-read"    # only if the bucket uses ACLs

# --- Tamil PDF fonts (invoices + result reports) ---------------------------
# Absolute paths to a Noto Sans Tamil TTF. Without a Tamil font on the host,
# PDFs silently fall back to English-only. Bundle the OFL font in assets/fonts/
# or set these paths.
# NEET_TAMIL_FONT_REGULAR="/app/assets/fonts/NotoSansTamil-Regular.ttf"
# NEET_TAMIL_FONT_BOLD="/app/assets/fonts/NotoSansTamil-Bold.ttf"

# --- Error tracking (Sentry, optional) -------------------------------------
# Leave unset to disable entirely (no client bundle cost, server init skipped).
# SENTRY_DSN="https://<key>@<org>.ingest.sentry.io/<project>"        # server/edge
# NEXT_PUBLIC_SENTRY_DSN="https://<key>@<org>.ingest.sentry.io/<project>"  # client
# SENTRY_ENVIRONMENT="production"
# SENTRY_TRACES_SAMPLE_RATE="0.1"
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"

# --- Admin provisioning (used by `npm run admin:create`, one-off) ----------
# Set these only when running the create-admin script; do not commit real values.
# ADMIN_EMAIL="you@your-org.in"
# ADMIN_PASSWORD="a-strong-unique-secret"
# ADMIN_NAME="Administrator"
# ADMIN_ROLE="SUPER_ADMIN"
